# Zilliz Cloud credentials
ZILLIZ_URI=https://your-instance.zillizcloud.com
ZILLIZ_API_KEY=your-zilliz-api-key

# OpenAI API key (used for embeddings and chat completions)
OPENAI_API_KEY=your-openai-api-key

# Collection settings
COLLECTION_NAME=book_descriptions
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# Ingestion settings
BATCH_SIZE=100
